APP_ENV=dev
DATABASE_URL=postgresql+psycopg://sbstay:sbstay@localhost:5432/sbstay
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# 구글 OAuth (로그인 + 캘린더). 콘솔은 테스트 모드, 데모 계정을 테스트 사용자로 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
TOKEN_ENCRYPTION_KEY=   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# LLM (멘토 지원 키)
LLM_API_KEY=
LLM_MODEL=            # 멘토 지원 키의 모델명
LLM_BASE_URL=         # OpenAI 호환 API 주소 (비우면 OpenAI, 모델명이 claude- 로 시작하면 Anthropic). 키가 없으면 AI는 규칙 기반 폴백으로 동작
LLM_TIMEOUT_SECONDS=20

# 토스페이먼츠 결제위젯 시크릿 키 (개발자센터 > API 키 > 결제위젯 연동 키의 test_gsk_...).
# 클라이언트 키(test_gck_...)는 frontend/.env.local 의 NEXT_PUBLIC_TOSS_CLIENT_KEY 에 넣는다. 비우면 결제는 목업
TOSS_SECRET_KEY=

# PayPal (외국인 결제, 달러 청구). developer.paypal.com > Apps & Credentials > Sandbox 앱의 Client ID · Secret
# 프론트 frontend/.env.local 의 NEXT_PUBLIC_PAYPAL_CLIENT_ID 에도 같은 Client ID. 비우면 PayPal 숨김
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
USD_KRW_RATE=1400

# 테스트 결제 자동 환불 (시간). 24면 결제 하루 뒤 전액 환불. 0이면 끔. 테스트 키일 때만 동작
AUTO_REFUND_AFTER_HOURS=0

PLATFORM_FEE_RATE=0.10
