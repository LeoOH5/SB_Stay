NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# true면 백엔드 없이 src/lib/mock 데이터로 동작 (프론트 선개발용)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키의 "JavaScript 키".
# 플랫폼 > Web 사이트 도메인에 http://localhost:3100 (배포 주소도) 등록, 카카오맵 사용 설정 ON 필요.
# 비워 두면 OpenStreetMap으로 대신 표시
NEXT_PUBLIC_KAKAO_MAP_KEY=
